{
  "name": "wysiwyg-shield",
  "version": "0.2.1",
  "description": "Find what AI agents read but humans can't see: hidden prompt injection in files, web pages, PDFs, Office docs and MCP servers.",
  "type": "module",
  "bin": {
    "wysiwyg": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "prompt-injection",
    "ai-security",
    "llm-security",
    "agent-security",
    "hidden-text",
    "invisible-unicode",
    "ascii-smuggling",
    "unicode-tags",
    "cloaking",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "copilot",
    "sarif",
    "security",
    "scanner",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DeveshParagiri/wysiwyg.git"
  },
  "author": "Devesh Paragiri",
  "license": "MIT",
  "scripts": {
    "dev": "bun run src/cli/cli.ts",
    "build": "bun scripts/build.ts",
    "build:binary": "bun scripts/build-binary.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts",
    "format": "biome check --write src tests scripts",
    "redteam": "bun scripts/redteam.ts",
    "prepublishOnly": "bun run lint && bun run typecheck && bun test && bun run build",
    "build:plugin": "bun scripts/build-plugin.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "commander": "^13.1.0",
    "css-tree": "^3.2.1",
    "diff": "^7.0.0",
    "fflate": "^0.8.3",
    "markdown-it": "^14.1.0",
    "pdfjs-dist": "^5.4.0",
    "picocolors": "^1.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/css-tree": "^3.2.0",
    "@types/diff": "^7.0.0",
    "@types/markdown-it": "^14.1.0",
    "bun-types": "^1.3.8",
    "typescript": "^5.7.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/DeveshParagiri/wysiwyg#readme",
  "bugs": {
    "url": "https://github.com/DeveshParagiri/wysiwyg/issues"
  }
}
